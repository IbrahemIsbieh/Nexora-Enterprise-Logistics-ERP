<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_nexora_webhook_queue" model="ir.cron">
        <field name="name">Nexora: Send queued webhooks</field>
        <field name="model_id" ref="model_nexora_webhook_delivery"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="cron_nexora_api_purge" model="ir.cron">
        <field name="name">Nexora: Purge API logs and delivered webhooks</field>
        <field name="model_id" ref="model_nexora_api_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>