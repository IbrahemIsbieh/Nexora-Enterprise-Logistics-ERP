<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_integration" model="res.groups.privilege">
        <field name="name">Nexora Integration</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_integration_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_integration"/>
        <field name="implied_ids" eval="[Command.link(ref('nexora_core.group_nexora_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_integration_manager'))]"/>
    </record>
</odoo>