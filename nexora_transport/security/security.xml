<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_transport" model="res.groups.privilege">
        <field name="name">Nexora Transport</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_transport_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_transport"/>
        <field name="implied_ids" eval="[Command.link(ref('nexora_fleet.group_nexora_fleet_dispatcher'))]"/>
    </record>

    <record id="group_nexora_transport_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_transport"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_transport_dispatcher')),
            Command.link(ref('nexora_fleet.group_nexora_fleet_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_transport_manager'))]"/>
    </record>

    <record id="rule_nexora_transport_order_company" model="ir.rule">
        <field name="name">Nexora Transport Order: multi-company</field>
        <field name="model_id" ref="model_nexora_transport_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_shipment_company" model="ir.rule">
        <field name="name">Nexora Shipment: multi-company</field>
        <field name="model_id" ref="model_nexora_shipment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_transport_trip_company" model="ir.rule">
        <field name="name">Nexora Transport Trip: multi-company</field>
        <field name="model_id" ref="model_nexora_transport_trip"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>