<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nexora_transport" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nexora.transport</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nexora_core.res_config_settings_view_form_nexora"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='nexora_core']" position="inside">
                <block title="Transportation" name="nexora_transport_block">
                    <setting string="Strict Load Validation"
                             help="Block planning when the load exceeds the vehicle capacity or is incompatible (temperature, hazmat). When off, only a warning is logged on the trip.">
                        <field name="nexora_transport_strict_capacity"/>
                    </setting>
                    <setting string="On-time Grace Period"
                             help="Hours after the planned delivery during which a delivery is still considered on time.">
                        <field name="nexora_transport_ontime_grace_hours"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>