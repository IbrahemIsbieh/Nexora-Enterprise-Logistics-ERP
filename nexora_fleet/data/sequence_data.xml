<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_nexora_vehicle_assignment" model="ir.sequence">
        <field name="name">Nexora Vehicle Assignment</field>
        <field name="code">nexora.vehicle.assignment</field>
        <field name="prefix">NXA/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_nexora_vehicle_incident" model="ir.sequence">
        <field name="name">Nexora Vehicle Incident</field>
        <field name="code">nexora.vehicle.incident</field>
        <field name="prefix">NXI/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>