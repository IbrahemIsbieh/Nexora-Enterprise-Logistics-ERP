<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_nexora" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.nexora</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_nexora_assignments" type="object"
                        class="oe_stat_button" icon="fa-exchange">
                    <field name="nexora_assignment_count" widget="statinfo" string="Assignments"/>
                </button>
                <button name="action_view_nexora_incidents" type="object"
                        class="oe_stat_button" icon="fa-warning"
                        invisible="nexora_incident_count == 0">
                    <field name="nexora_incident_count" widget="statinfo" string="Incidents"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Nexora" name="nexora">
                    <group>
                        <group string="Availability">
                            <field name="nexora_availability" widget="badge"
                                   decoration-success="nexora_availability == 'available'"
                                   decoration-info="nexora_availability == 'assigned'"
                                   decoration-warning="nexora_availability == 'maintenance'"
                                   decoration-danger="nexora_availability == 'out_of_service'"/>
                            <field name="nexora_current_driver_id"/>
                            <field name="nexora_out_of_service"/>
                            <field name="nexora_in_maintenance"/>
                        </group>
                        <group string="Specifications">
                            <field name="nexora_vehicle_class"/>
                            <field name="nexora_max_payload"/>
                            <field name="nexora_cargo_volume"/>
                            <field name="nexora_axles"/>
                            <field name="nexora_temperature_class"/>
                            <field name="nexora_hazmat_certified"/>
                        </group>
                    </group>
                    <group>
                        <group string="Registration &amp; Documents">
                            <field name="nexora_registration_no"/>
                            <field name="nexora_registration_expiry"/>
                            <field name="nexora_insurance_policy"/>
                            <field name="nexora_insurance_expiry"/>
                            <field name="nexora_inspection_expiry"/>
                            <field name="nexora_doc_status" widget="badge"
                                   decoration-success="nexora_doc_status == 'valid'"
                                   decoration-warning="nexora_doc_status == 'expiring'"
                                   decoration-danger="nexora_doc_status == 'expired'"/>
                        </group>
                        <group string="Organization">
                            <field name="nexora_home_warehouse_id"/>
                            <field name="nexora_cost_center_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_list_nexora" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.nexora</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="nexora_vehicle_class" optional="show"/>
                <field name="nexora_availability" widget="badge" optional="show"
                       decoration-success="nexora_availability == 'available'"
                       decoration-info="nexora_availability == 'assigned'"
                       decoration-warning="nexora_availability == 'maintenance'"
                       decoration-danger="nexora_availability == 'out_of_service'"/>
                <field name="nexora_current_driver_id" optional="show"/>
                <field name="nexora_doc_status" widget="badge" optional="show"
                       decoration-success="nexora_doc_status == 'valid'"
                       decoration-warning="nexora_doc_status == 'expiring'"
                       decoration-danger="nexora_doc_status == 'expired'"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_nexora" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.nexora</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="nexora_available" string="Available"
                        domain="[('nexora_availability', '=', 'available')]"/>
                <filter name="nexora_assigned" string="Assigned"
                        domain="[('nexora_availability', '=', 'assigned')]"/>
                <filter name="nexora_unavailable" string="Unavailable"
                        domain="[('nexora_availability', 'in', ('maintenance', 'out_of_service'))]"/>
                <filter name="nexora_docs_expired" string="Expired Documents"
                        domain="['|', '|', ('nexora_registration_expiry', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('nexora_insurance_expiry', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('nexora_inspection_expiry', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_availability" string="Availability"
                            context="{'group_by': 'nexora_availability'}"/>
                    <filter name="group_class" string="Vehicle Class"
                            context="{'group_by': 'nexora_vehicle_class'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_nexora_vehicle_availability" model="ir.actions.act_window">
        <field name="name">Vehicle Availability</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_availability': 1}</field>
    </record>
</odoo>