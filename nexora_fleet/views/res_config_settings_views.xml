<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nexora_fleet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nexora.fleet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nexora_core.res_config_settings_view_form_nexora"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='nexora_core']" position="inside">
                <block title="Fleet" name="nexora_fleet_block">
                    <setting string="Vehicle Document Alert"
                             help="Days before registration, insurance or inspection expiry to create a reminder.">
                        <field name="nexora_fleet_doc_alert_days"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>