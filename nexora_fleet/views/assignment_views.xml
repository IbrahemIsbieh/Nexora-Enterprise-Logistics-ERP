<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexora_vehicle_assignment_list" model="ir.ui.view">
        <field name="name">nexora.vehicle.assignment.list</field>
        <field name="model">nexora.vehicle.assignment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('done', 'cancelled')"
                  decoration-info="state == 'active'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="purpose" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="distance" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('planned', 'active')"/>
            </list>
        </field>
    </record>

    <record id="view_nexora_vehicle_assignment_form" model="ir.ui.view">
        <field name="name">nexora.vehicle.assignment.form</field>
        <field name="model">nexora.vehicle.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_finish" type="object" string="Finish"
                            class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'planned', 'active')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,active,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="state not in ('draft', 'planned')"/>
                            <field name="driver_id" readonly="state not in ('draft', 'planned')"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state not in ('draft', 'planned')"/>
                            <field name="date_end" readonly="state in ('done', 'cancelled')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Odometer" invisible="state in ('draft', 'planned')">
                        <group>
                            <field name="odometer_start" readonly="1"/>
                            <field name="odometer_end" readonly="state != 'active'"/>
                            <field name="distance"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nexora_vehicle_assignment_search" model="ir.ui.view">
        <field name="name">nexora.vehicle.assignment.search</field>
        <field name="model">nexora.vehicle.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('draft', 'planned', 'active'))]"/>
                <group>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_vehicle_assignment" model="ir.actions.act_window">
        <field name="name">Vehicle Assignments</field>
        <field name="res_model">nexora.vehicle.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>