<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_fleet" model="res.groups.privilege">
        <field name="name">Nexora Fleet</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_fleet_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_fleet"/>
        <field name="implied_ids" eval="[
            Command.link(ref('nexora_core.group_nexora_user')),
            Command.link(ref('fleet.fleet_group_user'))]"/>
    </record>

    <record id="group_nexora_fleet_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_fleet"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_fleet_dispatcher')),
            Command.link(ref('nexora_core.group_nexora_manager')),
            Command.link(ref('fleet.fleet_group_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_fleet_manager'))]"/>
    </record>

    <record id="rule_nexora_vehicle_assignment_company" model="ir.rule">
        <field name="name">Nexora Vehicle Assignment: multi-company</field>
        <field name="model_id" ref="model_nexora_vehicle_assignment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_vehicle_incident_company" model="ir.rule">
        <field name="name">Nexora Vehicle Incident: multi-company</field>
        <field name="model_id" ref="model_nexora_vehicle_incident"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>