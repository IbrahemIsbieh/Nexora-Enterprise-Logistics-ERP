<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_warehouse" model="res.groups.privilege">
        <field name="name">Nexora Warehouse</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_warehouse_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_warehouse"/>
        <field name="implied_ids" eval="[
            Command.link(ref('nexora_core.group_nexora_user')),
            Command.link(ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_nexora_warehouse_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_warehouse"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_warehouse_operator')),
            Command.link(ref('nexora_core.group_nexora_manager')),
            Command.link(ref('stock.group_stock_manager'))]"/>
    </record>

    <!-- Nexora administrators are warehouse managers -->
    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_warehouse_manager'))]"/>
    </record>

    <record id="rule_nexora_scan_session_company" model="ir.rule">
        <field name="name">Nexora Scan Session: multi-company</field>
        <field name="model_id" ref="model_nexora_scan_session"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>