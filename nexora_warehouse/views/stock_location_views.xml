<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_nexora" model="ir.ui.view">
        <field name="name">stock.location.form.nexora</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Nexora Storage &amp; Capacity" name="nexora"
                       invisible="usage != 'internal'">
                    <group>
                        <field name="nexora_location_type"/>
                        <field name="nexora_temperature_class"/>
                        <field name="nexora_allow_hazardous"/>
                        <field name="nexora_enforce_rules"/>
                    </group>
                    <group>
                        <field name="nexora_max_weight"/>
                        <field name="nexora_max_volume"/>
                        <field name="nexora_used_weight"/>
                        <field name="nexora_used_volume"/>
                        <field name="nexora_occupancy" widget="progressbar"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_nexora_location_capacity_list" model="ir.ui.view">
        <field name="name">stock.location.list.nexora.capacity</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <list decoration-danger="nexora_occupancy >= 100"
                  decoration-warning="nexora_occupancy >= 85 and nexora_occupancy &lt; 100">
                <field name="complete_name"/>
                <field name="warehouse_id"/>
                <field name="nexora_location_type"/>
                <field name="nexora_temperature_class" optional="show"/>
                <field name="nexora_max_weight" optional="show"/>
                <field name="nexora_used_weight" optional="show"/>
                <field name="nexora_max_volume" optional="show"/>
                <field name="nexora_used_volume" optional="show"/>
                <field name="nexora_occupancy" widget="progressbar"/>
                <field name="nexora_enforce_rules" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nexora_location_capacity_search" model="ir.ui.view">
        <field name="name">stock.location.search.nexora.capacity</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name" string="Location"/>
                <field name="warehouse_id"/>
                <field name="barcode"/>
                <filter name="enforced" string="Rules Enforced"
                        domain="[('nexora_enforce_rules', '=', True)]"/>
                <filter name="hazardous" string="Accepts Hazardous"
                        domain="[('nexora_allow_hazardous', '=', True)]"/>
                <group>
                    <filter name="group_warehouse" string="Warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_type" string="Functional Type"
                            context="{'group_by': 'nexora_location_type'}"/>
                    <filter name="group_temp" string="Temperature"
                            context="{'group_by': 'nexora_temperature_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_location_capacity" model="ir.actions.act_window">
        <field name="name">Locations &amp; Capacity</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('usage', '=', 'internal')]</field>
        <field name="context">{'search_default_group_warehouse': 1}</field>
        <field name="view_id" ref="view_nexora_location_capacity_list"/>
        <field name="search_view_id" ref="view_nexora_location_capacity_search"/>
    </record>
</odoo>