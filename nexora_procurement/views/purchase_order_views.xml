<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_nexora" model="ir.ui.view">
        <field name="name">purchase.order.form.nexora</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="request_id" invisible="not request_id"/>
                <field name="tender_id" invisible="not tender_id"/>
                <field name="nexora_vendor_rating" invisible="not nexora_vendor_rating"/>
            </xpath>
        </field>
    </record>

    <record id="action_nexora_rfq_orders" model="ir.actions.act_window">
        <field name="name">RFQs &amp; Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_nexora_purchase_analysis" model="ir.actions.act_window">
        <field name="name">Procurement Analysis</field>
        <field name="res_model">purchase.report</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>