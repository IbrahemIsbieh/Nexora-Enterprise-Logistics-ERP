<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nexora_procurement" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nexora.procurement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nexora_core.res_config_settings_view_form_nexora"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='nexora_core']" position="inside">
                <block title="Procurement" name="nexora_procurement_block">
                    <setting string="Performance Window"
                             help="Days of confirmed purchase orders considered when rating vendors.">
                        <field name="nexora_performance_days"/>
                    </setting>
                    <setting string="On-time Grace Period"
                             help="Days after the expected date during which a receipt is still on time.">
                        <field name="nexora_ontime_grace_days"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>