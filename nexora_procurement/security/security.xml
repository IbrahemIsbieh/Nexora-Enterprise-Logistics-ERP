<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_procurement" model="res.groups.privilege">
        <field name="name">Nexora Procurement</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_procurement_user" model="res.groups">
        <field name="name">Requester</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_procurement"/>
        <field name="implied_ids" eval="[Command.link(ref('nexora_core.group_nexora_user'))]"/>
    </record>

    <record id="group_nexora_procurement_officer" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_procurement"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_procurement_user')),
            Command.link(ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_nexora_procurement_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_procurement"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_procurement_officer')),
            Command.link(ref('nexora_core.group_nexora_manager')),
            Command.link(ref('purchase.group_purchase_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_procurement_manager'))]"/>
    </record>

    <!-- Requesters see their own requests (or the ones they must approve); officers see all -->
    <record id="rule_nexora_pr_user_own" model="ir.rule">
        <field name="name">Purchase Request: own or to approve</field>
        <field name="model_id" ref="model_nexora_purchase_request"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('approver_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_nexora_procurement_user'))]"/>
    </record>

    <record id="rule_nexora_pr_officer_all" model="ir.rule">
        <field name="name">Purchase Request: officers see all</field>
        <field name="model_id" ref="model_nexora_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_nexora_procurement_officer'))]"/>
    </record>

    <record id="rule_nexora_pr_company" model="ir.rule">
        <field name="name">Purchase Request: multi-company</field>
        <field name="model_id" ref="model_nexora_purchase_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_tender_company" model="ir.rule">
        <field name="name">RFQ Tender: multi-company</field>
        <field name="model_id" ref="model_nexora_rfq_tender"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_approval_rule_company" model="ir.rule">
        <field name="name">Approval Rule: multi-company</field>
        <field name="model_id" ref="model_nexora_purchase_approval_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_vendor_performance_company" model="ir.rule">
        <field name="name">Vendor Performance: multi-company</field>
        <field name="model_id" ref="model_nexora_vendor_performance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>