<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_accounting" model="res.groups.privilege">
        <field name="name">Nexora Accounting</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_accounting_user" model="res.groups">
        <field name="name">Billing</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_accounting"/>
        <field name="implied_ids" eval="[
            Command.link(ref('nexora_core.group_nexora_user')),
            Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_nexora_accounting_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_accounting"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_accounting_user')),
            Command.link(ref('nexora_core.group_nexora_manager')),
            Command.link(ref('account.group_account_user'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_accounting_manager'))]"/>
    </record>

    <record id="rule_nexora_freight_rate_company" model="ir.rule">
        <field name="name">Nexora Freight Rate: multi-company</field>
        <field name="model_id" ref="model_nexora_freight_rate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_cost_center_report_company" model="ir.rule">
        <field name="name">Nexora Cost Center Report: multi-company</field>
        <field name="model_id" ref="model_nexora_cost_center_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>