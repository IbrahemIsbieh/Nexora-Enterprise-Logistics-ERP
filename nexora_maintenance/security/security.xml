<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_maintenance" model="res.groups.privilege">
        <field name="name">Nexora Maintenance</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_maintenance_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_maintenance"/>
        <field name="implied_ids" eval="[Command.link(ref('nexora_fleet.group_nexora_fleet_dispatcher'))]"/>
    </record>

    <record id="group_nexora_maintenance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_maintenance"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_maintenance_technician')),
            Command.link(ref('nexora_fleet.group_nexora_fleet_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_maintenance_manager'))]"/>
    </record>

    <record id="rule_nexora_maintenance_plan_company" model="ir.rule">
        <field name="name">Nexora Maintenance Plan: multi-company</field>
        <field name="model_id" ref="model_nexora_maintenance_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_maintenance_order_company" model="ir.rule">
        <field name="name">Nexora Maintenance Order: multi-company</field>
        <field name="model_id" ref="model_nexora_maintenance_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>