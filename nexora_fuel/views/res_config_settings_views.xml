<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nexora_fuel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nexora.fuel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nexora_core.res_config_settings_view_form_nexora"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='nexora_core']" position="inside">
                <block title="Fuel" name="nexora_fuel_block">
                    <setting string="Abnormal Consumption Threshold"
                             help="A fill is flagged when its consumption exceeds the reference by more than this percentage.">
                        <field name="nexora_fuel_anomaly_pct"/>
                    </setting>
                    <setting string="Fuel Card Expiry Alert"
                             help="Days before card expiry to remind the responsible user.">
                        <field name="nexora_fuel_card_alert_days"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>