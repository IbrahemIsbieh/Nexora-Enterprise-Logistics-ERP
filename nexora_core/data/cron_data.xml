<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_nexora_contract_maintenance" model="ir.cron">
        <field name="name">Nexora: Contract expiry &amp; alerts</field>
        <field name="model_id" ref="model_nexora_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_contract_maintenance()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="cron_nexora_license_alert" model="ir.cron">
        <field name="name">Nexora: Driver license alerts</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_license_expiry_alert()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>