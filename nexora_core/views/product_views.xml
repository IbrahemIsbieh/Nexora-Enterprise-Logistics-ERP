<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_nexora" model="ir.ui.view">
        <field name="name">product.template.form.nexora</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nexora" name="nexora">
                    <group>
                        <group string="Logistics">
                            <field name="nexora_service_type"/>
                            <field name="nexora_temperature_class"/>
                            <field name="nexora_hazardous"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>