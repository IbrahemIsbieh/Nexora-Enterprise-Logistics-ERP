<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_nexora" model="ir.ui.view">
        <field name="name">res.company.form.nexora</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nexora" name="nexora">
                    <group>
                        <group string="Branch Information">
                            <field name="nexora_branch_code"/>
                            <field name="nexora_branch_type"/>
                            <field name="nexora_manager_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>