<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexora_contract_list" model="ir.ui.view">
        <field name="name">nexora.contract.list</field>
        <field name="model">nexora.contract</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="service_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_to_expiry" optional="hide"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_nexora_contract_form" model="ir.ui.view">
        <field name="name">nexora.contract.form</field>
        <field name="model">nexora.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'active')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="title" placeholder="Contract title"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contract_type"/>
                            <field name="service_type"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="days_to_expiry" invisible="state != 'active' or not date_end"/>
                            <field name="auto_renew"/>
                        </group>
                    </group>
                    <group>
                        <group string="Financial">
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_value"/>
                            <field name="payment_term_id"/>
                            <field name="cost_center_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agreed Rates" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="min_quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Conditions" name="terms">
                            <field name="terms"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nexora_contract_search" model="ir.ui.view">
        <field name="name">nexora.contract.search</field>
        <field name="model">nexora.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="customers" string="Customer Contracts" domain="[('contract_type', '=', 'customer')]"/>
                <filter name="vendors" string="Vendor Contracts" domain="[('contract_type', '=', 'vendor')]"/>
                <group>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_service" string="Service Type" context="{'group_by': 'service_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">nexora.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>