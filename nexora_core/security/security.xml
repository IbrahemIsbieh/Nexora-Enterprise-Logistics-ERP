<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nexora" model="ir.module.category">
        <field name="name">Nexora</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_nexora" model="res.groups.privilege">
        <field name="name">Nexora ERP</field>
        <field name="category_id" ref="module_category_nexora"/>
    </record>

    <record id="group_nexora_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_nexora_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_user'))]"/>
    </record>

    <record id="group_nexora_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_nexora_cost_center_company" model="ir.rule">
        <field name="name">Nexora Cost Center: multi-company</field>
        <field name="model_id" ref="model_nexora_cost_center"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_contract_company" model="ir.rule">
        <field name="name">Nexora Contract: multi-company</field>
        <field name="model_id" ref="model_nexora_contract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>