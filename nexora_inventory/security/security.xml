<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_inventory" model="res.groups.privilege">
        <field name="name">Nexora Inventory</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_inventory_planner" model="res.groups">
        <field name="name">Planner</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_inventory"/>
        <field name="implied_ids" eval="[Command.link(ref('nexora_warehouse.group_nexora_warehouse_operator'))]"/>
    </record>

    <record id="group_nexora_inventory_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_inventory"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_inventory_planner')),
            Command.link(ref('nexora_warehouse.group_nexora_warehouse_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_inventory_manager'))]"/>
    </record>

    <record id="rule_nexora_inventory_analysis_company" model="ir.rule">
        <field name="name">Nexora Inventory Analysis: multi-company</field>
        <field name="model_id" ref="model_nexora_inventory_analysis"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_replenishment_plan_company" model="ir.rule">
        <field name="name">Nexora Replenishment Plan: multi-company</field>
        <field name="model_id" ref="model_nexora_replenishment_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>