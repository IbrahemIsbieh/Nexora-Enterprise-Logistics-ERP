<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexora_analysis_wizard_form" model="ir.ui.view">
        <field name="name">nexora.analysis.wizard.form</field>
        <field name="model">nexora.analysis.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Scope">
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="history_days"/>
                        <field name="horizon_days"/>
                    </group>
                    <group string="Planning Parameters">
                        <field name="service_level"/>
                        <field name="default_lead_time"/>
                        <field name="overstock_days"/>
                        <field name="create_plan"/>
                    </group>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Run Analysis"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nexora_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Run Inventory Analysis</field>
        <field name="res_model">nexora.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>