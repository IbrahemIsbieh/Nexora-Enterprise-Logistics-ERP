<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nexora_replenishment_plan_list" model="ir.ui.view">
        <field name="name">nexora.replenishment.plan.list</field>
        <field name="model">nexora.replenishment.plan</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="plan_date"/>
                <field name="line_count"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_nexora_replenishment_plan_form" model="ir.ui.view">
        <field name="name">nexora.replenishment.plan.form</field>
        <field name="model">nexora.replenishment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply" type="object" string="Apply to Reordering Rules"
                            class="btn-primary" invisible="state != 'approved'"
                            groups="nexora_inventory.group_nexora_inventory_manager"
                            confirm="This will create or update reordering rules for all approved lines. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'approved')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('approved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="plan_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state in ('applied', 'cancelled')">
                                <list editable="bottom" create="0"
                                      decoration-danger="risk_level in ('stockout', 'critical')"
                                      decoration-warning="risk_level == 'low'">
                                    <field name="product_id" readonly="1"/>
                                    <field name="risk_level" widget="badge" readonly="1"/>
                                    <field name="on_hand" readonly="1"/>
                                    <field name="position" readonly="1" optional="hide"/>
                                    <field name="forecast_daily" readonly="1"/>
                                    <field name="lead_time" readonly="1" optional="show"/>
                                    <field name="reorder_point" readonly="1"/>
                                    <field name="suggested_qty" readonly="1"/>
                                    <field name="approved_qty" readonly="parent.state != 'draft'"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="vendor_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nexora_replenishment_plan_search" model="ir.ui.view">
        <field name="name">nexora.replenishment.plan.search</field>
        <field name="model">nexora.replenishment.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="warehouse_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_replenishment_plan" model="ir.actions.act_window">
        <field name="name">Replenishment Plans</field>
        <field name="res_model">nexora.replenishment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>