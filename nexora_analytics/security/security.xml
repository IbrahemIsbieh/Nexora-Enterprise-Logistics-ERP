<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nexora_analytics" model="res.groups.privilege">
        <field name="name">Nexora Analytics</field>
        <field name="category_id" ref="nexora_core.module_category_nexora"/>
    </record>

    <record id="group_nexora_analytics_user" model="res.groups">
        <field name="name">Analyst</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_analytics"/>
        <field name="implied_ids" eval="[Command.link(ref('nexora_core.group_nexora_user'))]"/>
    </record>

    <record id="group_nexora_analytics_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora_analytics"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_nexora_analytics_user')),
            Command.link(ref('nexora_core.group_nexora_manager'))]"/>
    </record>

    <record id="nexora_core.group_nexora_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_nexora_analytics_manager'))]"/>
    </record>

    <record id="rule_nexora_alert_company" model="ir.rule">
        <field name="name">Nexora Alert: multi-company</field>
        <field name="model_id" ref="model_nexora_alert"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_delivery_report_company" model="ir.rule">
        <field name="name">Delivery Report: multi-company</field>
        <field name="model_id" ref="model_nexora_delivery_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_fleet_report_company" model="ir.rule">
        <field name="name">Fleet Report: multi-company</field>
        <field name="model_id" ref="model_nexora_fleet_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_demand_report_company" model="ir.rule">
        <field name="name">Demand Report: multi-company</field>
        <field name="model_id" ref="model_nexora_demand_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nexora_supplier_report_company" model="ir.rule">
        <field name="name">Supplier Report: multi-company</field>
        <field name="model_id" ref="model_nexora_supplier_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>