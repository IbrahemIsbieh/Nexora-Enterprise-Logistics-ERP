<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nexora_analytics" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nexora.analytics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nexora_core.res_config_settings_view_form_nexora"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='nexora_core']" position="inside">
                <block title="Analytics &amp; Alerts" name="nexora_analytics_block">
                    <setting string="Dashboard Period"
                             help="Number of past days used by the Control Tower KPIs.">
                        <field name="nexora_dashboard_days"/>
                    </setting>
                    <setting string="Working Hours per Vehicle per Day"
                             help="Denominator of the fleet utilization rate.">
                        <field name="nexora_working_hours"/>
                    </setting>
                    <setting string="Pending Approval Alert"
                             help="Days a purchase request may wait for approval before an alert is raised.">
                        <field name="nexora_approval_stale_days"/>
                    </setting>
                    <setting string="Default Alert Responsible"
                             help="Gets the activity for high-severity alerts that have no natural owner. Defaults to the administrator.">
                        <field name="nexora_alert_responsible_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>